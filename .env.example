# =================================================================
# Aliento Andino — Template Único de Variables de Entorno (.env.example)
#
# Uso:
#   Local (Docker Compose):     cp .env.example .env
#   Producción (VPS / Cloud):   cp .env.example .env.production
# =================================================================

# --- Mapeo de Puertos Host (Docker Compose) ---
# Local: puertos dedicados no conflictivos
# Producción: PORT_NGINX=80, PORT_DB=5432
PORT_NGINX=8090
PORT_BACKEND=8050
PORT_WEB=4250
PORT_DOCS=3050
PORT_ML=8051
PORT_DB=15432

# --- Base de Datos PostgreSQL 16 ---
# Local: aliento_andino / dev_secret_andino_123
# Producción: credenciales seguras de producción
POSTGRES_USER=aliento_andino
POSTGRES_PASSWORD=dev_secret_andino_123
POSTGRES_DB=aliento_andino

# --- Backend API REST (FastAPI) ---
# En producción: generar con python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_secret_key_aliento_andino_2026_super_seguro_min_32_chars
DEBUG=true

# Local: http://localhost:4250 | Producción: https://alientoandino.org
FRONTEND_URL=http://localhost:4250

# Orígenes CORS permitidos (JSON array o lista separada por comas)
CORS_ORIGINS=["http://localhost:4250","http://localhost:4200","http://localhost:8050","http://localhost:8000","http://localhost:3050","http://localhost:3001","http://localhost:8090","http://localhost:80"]

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com

# --- Administrador Inicial (Aprovisionamiento Automático) ---
ADMIN_EMAIL=admin@alientoandino.org
ADMIN_PASSWORD=Admin1234!
ADMIN_USERNAME=admin
ADMIN_NAME="Administrador Aliento Andino"

# --- Servidor SMTP / Email Transaccional ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@alientoandino.org
SMTP_PASSWORD=secret
SMTP_FROM_NAME=Aliento Andino
SMTP_FROM_EMAIL=notificaciones@alientoandino.org

# --- Google Cloud / Vertex AI / Cloud Storage (Opcional en dev local) ---
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GCS_BUCKET_NAME=
