# Puerto local a exponer (8050 para backend directo, u 80 para Nginx local)
LOCAL_PORT=8050

# Host local
LOCAL_HOST=localhost

# Subdominio personalizado (opcional - dejar vacío para uno aleatorio)
SUBDOMAIN=aliento-andino-dev

# Tiempo entre reintentos en milisegundos
RECONNECT_DELAY=5000

# Máximo de reintentos (0 = infinito)
MAX_RECONNECT_ATTEMPTS=0

# Intervalo de health check en milisegundos
HEALTH_CHECK_INTERVAL=30000

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info
