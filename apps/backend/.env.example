# =================================================================
# Aliento Andino — Backend API (.env.example)
#
# Para ejecutar en host sin Docker (pnpm dev:backend:host):
#   cp apps/backend/.env.example apps/backend/.env
# =================================================================

# Base de datos PostgreSQL (conectar a localhost:15432 expuesto por Docker o DB local)
DATABASE_URL=postgresql+asyncpg://aliento_andino:dev_secret_andino_123@localhost:15432/aliento_andino

# JWT y Seguridad (Mínimo 32 caracteres)
SECRET_KEY=dev_secret_key_aliento_andino_2026_super_seguro_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Modo depuración (true para desarrollo, false para producción)
DEBUG=true

# URL del Frontend Web (usado en emails de recuperación de contraseña)
FRONTEND_URL=http://localhost:4250

# CORS — Orígenes permitidos (JSON array o lista separada por comas)
CORS_ORIGINS=["http://localhost:4250","http://localhost:4200","http://localhost:8050","http://localhost:8000","http://localhost:3050","http://localhost:3001","http://localhost:8090","http://localhost:80"]

# Google OAuth 2.0
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com

# Servidor de Correo SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@alientoandino.org
SMTP_PASSWORD=secret
SMTP_FROM_NAME=Aliento Andino
SMTP_FROM_EMAIL=notificaciones@alientoandino.org

# Google Cloud Platform (Opcional en desarrollo local)
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GCS_BUCKET_NAME=
