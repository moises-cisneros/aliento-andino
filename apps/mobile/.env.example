# =================================================================
# Aliento Andino — Mobile Flutter (.env.example)
#
# Para desarrollo o build, pasar las variables con:
#   flutter run --dart-define-from-file=.env
# O vía argumentos de compilación:
#   flutter build apk --dart-define=API_BASE_URL=https://api.alientoandino.org/api
# =================================================================

# URL base del API Backend
# Emulador Android: http://10.0.2.2:8050/api
# Web local: http://localhost:8050/api
# Dispositivo Físico: http://<TU_IP_LOCAL>:8050/api
# Producción: https://api.alientoandino.org/api
API_BASE_URL=http://localhost:8050/api

# URL base del portal Web para compartir enlaces
WEB_BASE_URL=https://alientoandino.org

# Google OAuth Web Client ID
GOOGLE_WEB_CLIENT_ID=85165749876-fttcpknkrnmhr7v7nn7m737o3f3e7cnq.apps.googleusercontent.com
