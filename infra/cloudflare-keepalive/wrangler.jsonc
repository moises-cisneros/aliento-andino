{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aliento-keepalive",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "vars": {
    // Lista separada por comas de URLs completas a consultar (ej. health checks).
    // Backend:  https://<backend>.run.app/health (Cloud Run)
    // ML:       https://<ml>.run.app/health (Cloud Run)
    // Vacia por ahora: agregar las URLs al desplegar los servicios.
    "TARGETS": "https://aliento-backend-788250326019.us-central1.run.app/health,https://aliento-ml-788250326019.us-central1.run.app/health,https://alientoandinoo.duckdns.org",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
